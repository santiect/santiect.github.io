---
import { site } from "../data/site";
import GraphBackground from "./GraphBackground.astro";
---

<section class="relative overflow-hidden bg-gradient-to-b from-ink-900 to-ink-800 text-paper-50">
  <GraphBackground class="text-accent-400/20" />
  <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/40 to-transparent" />

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="flex flex-col sm:flex-row items-center gap-8 sm:gap-12">
      <img
        src={site.photo}
        alt={`Foto de ${site.name}`}
        class="h-36 w-36 sm:h-48 sm:w-48 rounded-full object-cover ring-4 ring-accent-500/40 shrink-0"
        width="192"
        height="192"
      />
      <div class="text-center sm:text-left">
        <h1 class="text-3xl sm:text-4xl font-semibold text-paper-50">{site.name}</h1>
        <p class="mt-2 text-accent-300 font-medium">{site.role}</p>
        <p class="mt-4 max-w-2xl text-paper-100/85 leading-relaxed">
          {site.tagline}
        </p>
      </div>
    </div>
  </div>
</section>
