---
/**
 * Fundo animado do Hero, feito com p5.js: uma rede de "nós" à deriva, com
 * arestas surgindo por proximidade — remete a grafos/exploração do espaço
 * de busca em metaheurísticas. Puramente decorativo.
 *
 * Fallback sem JS / prefers-reduced-motion: o <GraphBackground /> estático
 * (SVG) por trás continua visível; este componente só assume quando o
 * canvas monta com sucesso e o usuário não pediu menos movimento.
 */
interface Props {
  accent?: string;
  gold?: string;
}
const { accent = "#45b8a4", gold = "#e2a53c" } = Astro.props;
---

<div
  id="hero-canvas"
  class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-700"
  data-accent={accent}
  data-gold={gold}
  aria-hidden="true"
>
</div>

<script>
  import p5 from "p5";

  const mount = document.getElementById("hero-canvas");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (mount && !reduceMotion) {
    const accentColor = mount.dataset.accent || "#45b8a4";
    const goldColor = mount.dataset.gold || "#e2a53c";

    const sketch = (p: any) => {
      let nodes: any[] = [];
      const COUNT = 42;
      const LINK_DIST = 130;

      function makeNodes(w: number, h: number) {
        nodes = Array.from({ length: COUNT }, () => ({
          x: p.random(w),
          y: p.random(h),
          vx: p.random(-0.15, 0.15),
          vy: p.random(-0.15, 0.15),
          pulse: p.random(p.TWO_PI),
          gold: p.random() < 0.12,
        }));
      }

      p.setup = () => {
        const c = p.createCanvas(mount.clientWidth, mount.clientHeight);
        c.parent(mount);
        p.pixelDensity(1);
        p.frameRate(30);
        makeNodes(p.width, p.height);
      };

      p.windowResized = () => {
        p.resizeCanvas(mount.clientWidth, mount.clientHeight);
        makeNodes(p.width, p.height);
      };

      p.draw = () => {
        p.clear();

        for (const n of nodes) {
          n.x += n.vx;
          n.y += n.vy;
          if (n.x < 0 || n.x > p.width) n.vx *= -1;
          if (n.y < 0 || n.y > p.height) n.vy *= -1;
          n.pulse += 0.02;
        }

        p.strokeWeight(1);
        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            const a = nodes[i];
            const b = nodes[j];
            const d = p.dist(a.x, a.y, b.x, b.y);
            if (d < LINK_DIST) {
              const alpha = Math.round(p.map(d, 0, LINK_DIST, 90, 0));
              p.stroke(accentColor + alpha.toString(16).padStart(2, "0"));
              p.line(a.x, a.y, b.x, b.y);
            }
          }
        }

        p.noStroke();
        for (const n of nodes) {
          const glow = 0.5 + 0.5 * Math.sin(n.pulse);
          const base = n.gold ? goldColor : accentColor;
          const alphaHex = Math.round(glow * 255)
            .toString(16)
            .padStart(2, "0");
          p.fill(base + alphaHex);
          p.circle(n.x, n.y, n.gold ? 5 : 4);
        }
      };
    };

    const instance = new p5(sketch);
    mount.classList.remove("opacity-0");
    mount.classList.add("opacity-100");

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) instance.noLoop();
      else instance.loop();
    });
  }
</script>
