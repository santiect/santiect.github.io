---
/**
 * Fundo animado do Hero, feito com p5.js: uma rede de "nós" à deriva, com
 * arestas surgindo por proximidade, leve reação ao mouse, e uma "rota"
 * que pulsa periodicamente entre nós — remete a busca/exploração do
 * espaço de soluções em metaheurísticas. Puramente decorativo.
 *
 * Fallback sem JS / prefers-reduced-motion: o <GraphBackground /> estático
 * (SVG) por trás continua visível; este componente só assume quando o
 * canvas monta com sucesso e o usuário não pediu menos movimento.
 */
interface Props {
  accent?: string;
  gold?: string;
  light?: string;
}
const { accent = "#45b8a4", gold = "#e2a53c", light = "#dff2ee" } = Astro.props;
---

<div
  id="hero-canvas"
  class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-700"
  data-accent={accent}
  data-gold={gold}
  data-light={light}
  aria-hidden="true"
>
</div>

<script>
  import p5 from "p5";

  const mount = document.getElementById("hero-canvas");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (mount && !reduceMotion) {
    const accentColor = mount.dataset.accent || "#45b8a4";
    const goldColor = mount.dataset.gold || "#e2a53c";
    const lightColor = mount.dataset.light || "#dff2ee";

    const sketch = (p: any) => {
      let nodes: any[] = [];
      const COUNT = 64;
      const LINK_DIST = 165;
      const MOUSE_RADIUS = 140;

      let activePath: number[] = [];
      let pathStart = 0;
      let nextPathAt = 0;
      const PATH_DURATION = 1900;
      const PATH_INTERVAL = 3400;

      function colorFor(type: string) {
        if (type === "gold") return goldColor;
        if (type === "light") return lightColor;
        return accentColor;
      }

      function makeNodes(w: number, h: number) {
        nodes = Array.from({ length: COUNT }, () => {
          const roll = p.random();
          const type = roll < 0.14 ? "gold" : roll < 0.26 ? "light" : "accent";
          return {
            x: p.random(w),
            y: p.random(h),
            vx: p.random(-0.22, 0.22),
            vy: p.random(-0.22, 0.22),
            pulse: p.random(p.TWO_PI),
            r: type === "accent" ? p.random(2.5, 4) : p.random(3.5, 6),
            type,
          };
        });
      }

      function neighborsOf(i: number) {
        const out: number[] = [];
        for (let j = 0; j < nodes.length; j++) {
          if (j === i) continue;
          if (p.dist(nodes[i].x, nodes[i].y, nodes[j].x, nodes[j].y) < LINK_DIST) out.push(j);
        }
        return out;
      }

      function buildPath() {
        const start = Math.floor(p.random(nodes.length));
        const path = [start];
        const visited = new Set([start]);
        let current = start;
        const maxHops = 5 + Math.floor(p.random(3));

        for (let hop = 0; hop < maxHops; hop++) {
          const candidates = neighborsOf(current).filter((n) => !visited.has(n));
          if (candidates.length === 0) break;
          const next = candidates[Math.floor(p.random(candidates.length))];
          path.push(next);
          visited.add(next);
          current = next;
        }
        return path;
      }

      p.setup = () => {
        const c = p.createCanvas(mount.clientWidth, mount.clientHeight);
        c.parent(mount);
        p.pixelDensity(Math.min(window.devicePixelRatio || 1, 2));
        p.frameRate(30);
        makeNodes(p.width, p.height);
        nextPathAt = p.millis() + 900;
      };

      p.windowResized = () => {
        p.resizeCanvas(mount.clientWidth, mount.clientHeight);
        makeNodes(p.width, p.height);
      };

      p.draw = () => {
        p.clear();

        const hasMouse = p.mouseX > 0 && p.mouseY > 0 && p.mouseX < p.width && p.mouseY < p.height;

        for (const n of nodes) {
          if (hasMouse) {
            const d = p.dist(n.x, n.y, p.mouseX, p.mouseY);
            if (d < MOUSE_RADIUS && d > 0.001) {
              const push = p.map(d, 0, MOUSE_RADIUS, 0.55, 0);
              n.x += ((n.x - p.mouseX) / d) * push;
              n.y += ((n.y - p.mouseY) / d) * push;
            }
          }

          n.x += n.vx;
          n.y += n.vy;
          if (n.x < 0 || n.x > p.width) n.vx *= -1;
          if (n.y < 0 || n.y > p.height) n.vy *= -1;
          n.x = p.constrain(n.x, 0, p.width);
          n.y = p.constrain(n.y, 0, p.height);
          n.pulse += 0.025;
        }

        p.strokeWeight(1.1);
        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            const a = nodes[i];
            const b = nodes[j];
            const d = p.dist(a.x, a.y, b.x, b.y);
            if (d < LINK_DIST) {
              const alpha = Math.round(p.map(d, 0, LINK_DIST, 150, 0));
              p.stroke(accentColor + alpha.toString(16).padStart(2, "0"));
              p.line(a.x, a.y, b.x, b.y);
            }
          }
        }

        p.noStroke();
        for (const n of nodes) {
          const glow = 0.6 + 0.4 * Math.sin(n.pulse);
          const alphaHex = Math.round(glow * 255)
            .toString(16)
            .padStart(2, "0");
          p.fill(colorFor(n.type) + alphaHex);
          p.circle(n.x, n.y, n.r * 2);
        }

        // Rota pulsante: percorre alguns nós conectados periodicamente,
        // como se traçasse um caminho/solução sendo explorada.
        const now = p.millis();
        if (activePath.length < 2 && now > nextPathAt) {
          activePath = buildPath();
          pathStart = now;
        }

        if (activePath.length >= 2) {
          const elapsed = now - pathStart;
          const t = p.constrain(elapsed / PATH_DURATION, 0, 1);

          const segLengths: number[] = [];
          let total = 0;
          for (let k = 0; k < activePath.length - 1; k++) {
            const a = nodes[activePath[k]];
            const b = nodes[activePath[k + 1]];
            const len = p.dist(a.x, a.y, b.x, b.y);
            segLengths.push(len);
            total += len;
          }

          const traveled = t * total;
          let acc = 0;
          let markerX = nodes[activePath[0]].x;
          let markerY = nodes[activePath[0]].y;

          p.strokeWeight(2.4);
          for (let k = 0; k < activePath.length - 1; k++) {
            const a = nodes[activePath[k]];
            const b = nodes[activePath[k + 1]];
            const segLen = segLengths[k];
            const segT = p.constrain((traveled - acc) / segLen, 0, 1);

            if (segT > 0) {
              const ex = p.lerp(a.x, b.x, segT);
              const ey = p.lerp(a.y, b.y, segT);
              p.stroke(lightColor + "e6");
              p.line(a.x, a.y, ex, ey);
              if (segT < 1) {
                markerX = ex;
                markerY = ey;
              } else {
                markerX = b.x;
                markerY = b.y;
              }
            }
            acc += segLen;
          }

          p.noStroke();
          p.fill(lightColor);
          p.circle(markerX, markerY, 6.5);
          p.fill(lightColor + "33");
          p.circle(markerX, markerY, 16);

          if (t >= 1) {
            activePath = [];
            nextPathAt = now + PATH_INTERVAL;
          }
        }
      };
    };

    const instance = new p5(sketch);
    mount.classList.remove("opacity-0");
    mount.classList.add("opacity-100");

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) instance.noLoop();
      else instance.loop();
    });
  }
</script>
