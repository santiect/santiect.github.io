---
interface Props {
  title: string;
  kind: string;
  date: Date;
  location: string;
  summary: string;
  url?: string;
}
const { title, kind, date, location, summary, url } = Astro.props;

const formattedDate = date.toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});

const kindLabel: Record<string, string> = {
  curso: "Curso",
  palestra: "Palestra",
  workshop: "Workshop",
  evento: "Evento",
};

// Pequena variação de cor por tipo — dá diferenciação visual às seções de
// divulgação sem sair da paleta (accent para curso/workshop, gold para
// palestra/evento).
const kindColor: Record<string, string> = {
  curso: "text-accent-600",
  workshop: "text-accent-600",
  palestra: "text-gold-600",
  evento: "text-gold-600",
};
---

<div class="glow-accent rounded-xl border border-ink-200 bg-white p-6 shadow-sm">
  <div class={`flex items-center gap-2 text-xs font-semibold uppercase tracking-wide ${kindColor[kind] ?? "text-accent-600"}`}>
    <span>{kindLabel[kind] ?? kind}</span>
    <span class="text-ink-300">&middot;</span>
    <time datetime={date.toISOString()}>{formattedDate}</time>
  </div>
  <h3 class="mt-2 text-lg font-semibold text-ink-900">{title}</h3>
  <p class="mt-1 text-sm text-ink-500">{location}</p>
  <p class="mt-3 text-sm text-ink-600 leading-relaxed">{summary}</p>
  {
    url && (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent-600 hover:text-accent-800"
      >
        Saiba mais
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    )
  }
</div>
