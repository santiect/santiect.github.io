---
interface Props {
  slug: string;
  title: string;
  kind: string;
  date: Date;
  location: string;
  summary: string;
  url?: string;
}
const { slug, title, kind, date, location, summary, url } = Astro.props;

const formattedDate = date.toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});

const kindLabel: Record<string, string> = {
  curso: "Curso",
  palestra: "Palestra",
  workshop: "Workshop",
  evento: "Evento",
};

// Pequena variação de cor por tipo — dá diferenciação visual às seções de
// divulgação sem sair da paleta (accent para curso/workshop, gold para
// palestra/evento).
const kindColor: Record<string, string> = {
  curso: "text-accent-600",
  workshop: "text-accent-600",
  palestra: "text-gold-600",
  evento: "text-gold-600",
};
---

<div class="glow-accent group relative rounded-xl border border-ink-200 bg-white p-6 shadow-sm">
  <div class={`flex items-center gap-2 text-xs font-semibold uppercase tracking-wide ${kindColor[kind] ?? "text-accent-600"}`}>
    <span>{kindLabel[kind] ?? kind}</span>
    <span class="text-ink-300">&middot;</span>
    <time datetime={date.toISOString()}>{formattedDate}</time>
  </div>
  <h3 class="mt-2 text-lg font-semibold text-ink-900 group-hover:text-accent-700">
    {/* Link "esticado": cobre o card inteiro via ::after, mantendo o HTML válido
       mesmo havendo um segundo link (externo) dentro do mesmo card. */}
    <a href={`/cursos-palestras/${slug}/`} class="static after:absolute after:inset-0 after:content-['']">
      {title}
    </a>
  </h3>
  <p class="mt-1 text-sm text-ink-500">{location}</p>
  <p class="mt-3 text-sm text-ink-600 leading-relaxed">{summary}</p>
  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-medium">
    <span class="inline-flex items-center gap-1 text-accent-600 group-hover:text-accent-800">
      Ver detalhes
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </span>
    {
      url && (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="relative z-10 inline-flex items-center gap-1 text-ink-500 hover:text-ink-700"
        >
          Site oficial
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )
    }
  </div>
</div>
