---
interface Props {
  title: string;
  summary: string;
  url: string;
}
const { title, summary, url } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="glow-accent group block rounded-xl border border-ink-200 bg-white p-6 shadow-sm hover:border-accent-400"
>
  <h3 class="text-lg font-semibold text-ink-900 group-hover:text-accent-700">
    {title}
  </h3>
  <p class="mt-2 text-sm text-ink-600 leading-relaxed">{summary}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent-600 group-hover:text-accent-800">
    Ver página da disciplina
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </span>
</a>
