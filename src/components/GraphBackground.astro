---
/**
 * Padrão decorativo de grafo (nós + arestas), usado como fundo temático do
 * Hero — referência visual sutil à área de pesquisa (grafos, otimização
 * combinatória). Puramente decorativo (aria-hidden), sem interatividade.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class={`pointer-events-none absolute inset-0 h-full w-full ${className}`}
  viewBox="0 0 800 400"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <g stroke="currentColor" stroke-width="1" fill="none" opacity="0.5">
    <line x1="60" y1="90" x2="230" y2="40" />
    <line x1="230" y1="40" x2="390" y2="130" />
    <line x1="390" y1="130" x2="570" y2="70" />
    <line x1="230" y1="40" x2="190" y2="230" />
    <line x1="190" y1="230" x2="370" y2="270" />
    <line x1="370" y1="270" x2="570" y2="70" />
    <line x1="370" y1="270" x2="545" y2="330" />
    <line x1="545" y1="330" x2="710" y2="270" />
    <line x1="570" y1="70" x2="710" y2="130" />
    <line x1="710" y1="130" x2="710" y2="270" />
    <line x1="60" y1="90" x2="190" y2="230" />
  </g>
  <g fill="currentColor">
    <circle cx="60" cy="90" r="4.5" class="graph-node-pulse" />
    <circle cx="230" cy="40" r="4" opacity="0.7" />
    <circle cx="390" cy="130" r="4.5" class="graph-node-pulse" style="animation-delay:1.1s" />
    <circle cx="570" cy="70" r="4" opacity="0.7" />
    <circle cx="190" cy="230" r="4" opacity="0.7" />
    <circle cx="370" cy="270" r="4.5" class="graph-node-pulse" style="animation-delay:2.2s" />
    <circle cx="545" cy="330" r="4" opacity="0.7" />
    <circle cx="710" cy="270" r="4" opacity="0.7" />
    <circle cx="710" cy="130" r="4" opacity="0.7" />
  </g>
</svg>
