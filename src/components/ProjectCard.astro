---
interface Props {
  title: string;
  summary: string;
  tags: string[];
  url?: string;
}
const { title, summary, tags, url } = Astro.props;
const Tag = url ? "a" : "div";
---

<Tag
  href={url}
  target={url ? "_blank" : undefined}
  rel={url ? "noopener noreferrer" : undefined}
  class="group block h-full rounded-xl border border-ink-200 bg-white p-6 shadow-sm transition hover:shadow-md hover:border-accent-400"
>
  <h3 class="text-lg font-semibold text-ink-900 group-hover:text-accent-700">
    {title}
  </h3>
  <p class="mt-2 text-sm text-ink-600 leading-relaxed">{summary}</p>
  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="rounded-full bg-accent-50 px-3 py-1 text-xs font-medium text-accent-700">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</Tag>
