---
import BaseLayout from "./BaseLayout.astro";
import "katex/dist/katex.min.css";

interface Props {
  title: string;
  summary: string;
  date: Date;
  tags: string[];
}
const { title, summary, date, tags } = Astro.props;

const formattedDate = date.toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title={`${title} — Blog`} description={summary}>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
    <a href="/#blog" class="text-sm font-medium text-accent-600 hover:text-accent-800">&larr; Voltar ao blog</a>
    <header class="mt-4 mb-10">
      <time datetime={date.toISOString()} class="text-xs font-semibold uppercase tracking-wide text-accent-600">
        {formattedDate}
      </time>
      <h1 class="mt-2 text-3xl sm:text-4xl">{title}</h1>
      {
        tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="rounded-full bg-accent-50 px-3 py-1 text-xs font-medium text-accent-700">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="prose-academic">
      <slot />
    </div>
  </article>
</BaseLayout>
