---
import BaseLayout from "./BaseLayout.astro";
import "katex/dist/katex.min.css";

interface Props {
  title: string;
  kind: string;
  date: Date;
  location: string;
  summary: string;
  url?: string;
}
const { title, kind, date, location, summary, url } = Astro.props;

const formattedDate = date.toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});

const kindLabel: Record<string, string> = {
  curso: "Curso",
  palestra: "Palestra",
  workshop: "Workshop",
  evento: "Evento",
};
---

<BaseLayout title={`${title} — Cursos & Palestras`} description={summary}>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
    <a href="/#cursos-palestras" class="text-sm font-medium text-accent-600 hover:text-accent-800">
      &larr; Voltar a Cursos &amp; Palestras
    </a>
    <header class="mt-4 mb-10">
      <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-accent-600">
        <span>{kindLabel[kind] ?? kind}</span>
        <span class="text-ink-300">&middot;</span>
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </div>
      <h1 class="mt-2 text-3xl sm:text-4xl">{title}</h1>
      <p class="mt-2 text-ink-500">{location}</p>
    </header>
    <div class="prose-academic">
      <slot />
    </div>
    {
      url && (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-10 inline-flex items-center gap-1.5 rounded-lg border border-ink-200 px-4 py-2 text-sm font-medium text-ink-700 hover:border-accent-400 hover:text-accent-700"
        >
          Site oficial / inscrição
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )
    }
  </article>
</BaseLayout>
